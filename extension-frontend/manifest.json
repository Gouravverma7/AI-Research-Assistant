{
    "manifest_version":3,
    "name" : "research Assistant",
    "version" : "1.0",
    "description" : "This extension helps you to research and find information quickly.", 
    "permissions": [
        "activeTab",
        "storage",
        "sidePanel",
        "scripting"
    ],
    "action":{
        "default_title":"Research Assistant"        
    },
    "side_panel":{
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions":[
        "http://localhost:8083/*",
        "<all_urls>"
    ],
    "content_security_policy":{
        "extension_pages": "script-src 'self'; object-src 'self'"
    }

}